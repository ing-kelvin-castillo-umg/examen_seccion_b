<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Lista de revocación de access tokens (por jti). Cada entrada solo hace falta hasta que el JWT expira. -->
    <changeSet id="006-1-create-revoked-access-tokens-table" author="umg">
        <createTable tableName="revoked_access_tokens">
            <column name="jti" type="VARCHAR(64)">
                <constraints primaryKey="true" primaryKeyName="pk_revoked_access_tokens"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="revoked_access_tokens" indexName="idx_revoked_access_tokens_expires">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
