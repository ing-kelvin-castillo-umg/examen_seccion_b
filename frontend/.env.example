# URL interna del backend usada por el proxy inverso (BFF) de Next.js.
# Es una variable de servidor: NUNCA se expone al navegador.
# - Desarrollo local (npm run dev): http://localhost:8080
# - Docker Compose: se inyecta como http://backend:8080
BACKEND_URL=http://localhost:8080

# Cierre de sesión por inactividad (milisegundos). Valores de cliente, se fijan en build.
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MS=180000
NEXT_PUBLIC_INACTIVITY_WARNING_MS=30000
